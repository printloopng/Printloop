# ─────────────────────────────────────────────────────────────────────
# PrintLoop API: PRODUCTION environment template
# Copy to your platform's secret store. Never commit real values.
# ─────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
APP_VERSION=2.0.0

# ── Web apps (one Vercel project each) ────────────────────────────────
# Used for CORS and for the links in emails and redirects.
LANDING_URL=https://printloop.app
CUSTOMER_APP_URL=https://app.printloop.app
SHOP_APP_URL=https://shop.printloop.app
BACKOFFICE_URL=https://admin.printloop.app
ALLOWED_ORIGINS=https://printloop.app,https://app.printloop.app,https://shop.printloop.app,https://admin.printloop.app
# Same value as PL_EDGE_SECRET in every web app. Lets the apps pass the
# real visitor IP so rate limits don't treat all traffic as one address.
PL_EDGE_SECRET=CHANGE_ME_openssl_rand_hex_32

# ── Database (Postgres REQUIRED in prod) ──────────────────────────────
# SQLite is single-writer: never use it with more than one API instance.
# The driver selects Postgres when DATABASE_URL starts with postgres(ql)://.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/printloop
DB_SSL=true
DB_POOL_MAX=10

# ── Redis (REQUIRED: job queues, rate limits, live editor fan-out) ────
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# ── Auth ──────────────────────────────────────────────────────────────
# 32+ random chars: `openssl rand -hex 32`.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
# PrintLoop staff must use two-step sign-in in production. Leave unset.
# PLATFORM_REQUIRE_2FA=1

# ── SaaS / multi-tenancy ──────────────────────────────────────────────
COMMISSION_PCT_DEFAULT=0.10

# NEVER set SEED_DEMO=1 in production. It plants accounts whose
# passwords are public in this repo. The default gives a clean database;
# create the first PrintLoop staff account with
#   npm run admin:create -- <email> <password>
SEED_DEMO=0
# Domains we own: hosts ending in these resolve to {slug}.<apex>;
# anything else is treated as a shop's custom domain.
PRINTLOOP_APEX_DOMAINS=printloop.app
# CNAME target shops point their custom domains at (the TLS edge).
PRINTLOOP_DOMAINS_CNAME=domains.printloop.app

# ── Render worker callback (shared secret, both sides) ────────────────
# `openssl rand -hex 32`. Must match render-worker's RENDER_CALLBACK_SECRET.
RENDER_CALLBACK_SECRET=CHANGE_ME_openssl_rand_hex_32

# ── Payments (Paystack, live keys) ────────────────────────────────────
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxx
# Optional dedicated webhook-signing secret; falls back to SECRET_KEY.
# The dashboard webhook URL is https://<api-host>/api/webhooks/paystack
PAYSTACK_WEBHOOK_SECRET=

# ── File storage (S3-compatible) ──────────────────────────────────────
# Used by the render-worker for source and rendered artifacts.
S3_BUCKET=printloop-prod
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Office documents and the Edit & Print editor ──────────────────────
# Converts Word/PowerPoint/Excel to PDF, and edited documents to PDF.
GOTENBERG_URL=
# Optional: an external service that turns an edited document into a PDF.
UNIVER_EXPORT_URL=

# ── Email (transactional: Resend / Postmark / SES SMTP) ───────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=PrintLoop <noreply@printloop.app>

# ── SMS (Termii) ──────────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=PrintLoop

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=false
