NODE_ENV=production
SEED_DEMO=0
PRINT_DISPATCH_MODE=kiosk-pull
EMBED_WORKERS=1

PUBLIC_BASE_URL=https://printloop-api.onrender.com
LANDING_URL=https://printloop.ng
CUSTOMER_APP_URL=https://app.printloop.ng
SHOP_APP_URL=https://shop.printloop.ng
BACKOFFICE_URL=https://admin.printloop.ng
ALLOWED_ORIGINS=https://printloop.ng,https://app.printloop.ng,https://shop.printloop.ng,https://admin.printloop.ng
PRINTLOOP_APEX_DOMAINS=printloop.ng
PRINTLOOP_DOMAINS_CNAME=domains.printloop.ng
PL_EDGE_SECRET=CHANGE_ME_openssl_rand_hex_32

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/printloop
DB_SSL=true

REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Bull Board UI at /admin/queues (requires Redis + password)
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=

JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

COMMISSION_PCT_DEFAULT=0.10
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — https://resend.com/api-keys (verify your domain for production from=)
RESEND_API_KEY=
EMAIL_FROM=PrintLoop <noreply@printloop.ng>

TERMII_API_KEY=
TERMII_SENDER_ID=PrintLoop

GOTENBERG_URL=
UNIVER_EXPORT_URL=
