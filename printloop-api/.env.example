NODE_ENV=development
SEED_DEMO=1
PRINT_DISPATCH_MODE=kiosk-pull
EMBED_WORKERS=0

PUBLIC_BASE_URL=http://localhost:4000
LANDING_URL=http://localhost:3000
CUSTOMER_APP_URL=http://localhost:3001
SHOP_APP_URL=http://localhost:3002
BACKOFFICE_URL=http://localhost:3003
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
PRINTLOOP_APEX_DOMAINS=printloop.ng,printloop.test,localhost
PRINTLOOP_DOMAINS_CNAME=domains.printloop.ng
PL_EDGE_SECRET=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/printloop
DB_SSL=false

REDIS_URL=

# Bull Board UI at /admin/queues (requires Redis + password)
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=

JWT_SECRET=local-dev-secret-change-me-please-32c

COMMISSION_PCT_DEFAULT=0.10
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — https://resend.com/api-keys (verify your domain for production from=)
RESEND_API_KEY=
EMAIL_FROM=PrintLoop <noreply@printloop.ng>

TERMII_API_KEY=
TERMII_SENDER_ID=PrintLoop

GOTENBERG_URL=
UNIVER_EXPORT_URL=
