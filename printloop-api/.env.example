NODE_ENV=development
PORT=4000
APP_VERSION=2.0.0
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Leave DATABASE_URL unset for SQLite local dev
# DATABASE_URL=postgresql://printloop:printloop_dev@localhost:5432/printloop
DATABASE_FILE=./data/printloop.sqlite

# REDIS_URL=redis://localhost:6379

JWT_SECRET=local-dev-secret-change-me-please-32c
JWT_EXPIRES_IN=7d

SEED_DEMO=1
COMMISSION_PCT_DEFAULT=0.10
PRINTLOOP_APEX_DOMAINS=printloop.app,printloop.test,localhost
RENDER_CALLBACK_SECRET=dev-render-callback-secret

PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

LOG_LEVEL=info
LOG_PRETTY=true
