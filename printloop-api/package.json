{
  "name": "printloop-api",
  "version": "2.0.0",
  "description": "PrintLoop SaaS API — neurapath-style Express 5 + TypeORM modular monolith",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "start:dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "dev": "npm run start:dev",
    "worker": "ts-node --transpile-only -r tsconfig-paths/register src/workers/main.ts",
    "worker:dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/workers/main.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "db-migrate:run": "npx ts-node --project tsconfig.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run --dataSource src/config/data-source.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "boot": "ts-node --transpile-only -r tsconfig-paths/register src/index.ts",
    "start:worker": "node dist/workers/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@napi-rs/canvas": "^1.0.0",
    "@sentry/node": "^10.72.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.8",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "form-data": "^4.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "ipp": "^1.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.7",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "4.10.38",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "socks": "^2.8.10",
    "sqlite3": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.28",
    "typescript": "^5.9.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^9.0.7",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.8"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "@parcel/watcher@2.6.0": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.12.2": true
  }
}
