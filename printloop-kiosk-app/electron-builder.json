{
  "appId": "com.printloop.kiosk",
  "productName": "PrintLoop Kiosk",
  "copyright": "Copyright © 2026 PrintLoop",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "public/**/*"
  ],
  "win": {
    "target": "nsis",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "PrintLoop Kiosk"
  },
  "linux": {
    "target": "AppImage",
    "category": "Office"
  }
}
