{
  "name": "printloop-kiosk-app",
  "version": "1.0.0",
  "description": "PrintLoop Kiosk Application - Electron-based touchscreen UI for print shops",
  "main": "dist/main/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build",
    "dev": "concurrently \"tsc -p tsconfig.main.json -w\" \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "electron .",
    "package": "npm run build && electron-builder --win --x64",
    "package:linux": "npm run build && electron-builder --linux --x64",
    "lint": "eslint src --ext .ts,.tsx",
    "fake-printer": "node scripts/fake-printer.cjs"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.4.0",
    "ipp": "^1.1.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^44.9.0",
    "electron-builder": "^24.9.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "sharp@0.33.5": true
  },
  "author": "PrintLoop"
}
