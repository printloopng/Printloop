{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV", "PL_API_URL", "PL_APEX_DOMAINS", "PL_EDGE_SECRET", "NEXT_PUBLIC_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["SENTRY_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "e2e": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}
