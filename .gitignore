# ── Dependencies & build artefacts ────────────────────────────────────
node_modules/
dist/
build/
*.tsbuildinfo
# Exception: the kiosk Electron app has a build/ folder that holds
# app icons + icon generator scripts. Those are SOURCE, not
# generated, so they must ship with the repo.
!printloop-kiosk-app/build/
!printloop-kiosk-app/build/**

# Accidental tsc / vite emits next to source
printloop-kiosk-app/src/**/*.js
printloop-kiosk-app/src/**/*.js.map
printloop-kiosk-app/src/**/*.d.ts
printloop-kiosk-app/src/**/*.d.ts.map
printloop-kiosk-app/vite.config.js
printloop-kiosk-app/vite.config.js.map
printloop-kiosk-app/vite.config.d.ts
printloop-kiosk-app/vite.config.d.ts.map

# Installer binaries (build them; don't commit them)
*.exe
!printloop-kiosk-app/build/**

# ── Local secrets (never commit) ─────────────────────────────────────
.env
.env.local
.env.*.local

# ── Logs ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── OS / editor ──────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
Thumbs.db

# ── API runtime data ─────────────────────────────────────────────────
printloop-api/data/uploads/
printloop-api/data/printed/

# ── Vendored reference source (not built, not imported) ──────────────
# Local clones of OpenPrinting projects kept for reference only. The app
# uses cups-filters / Ghostscript at runtime on the host, never this
# source. Untracked to keep the repo lean (~139 MB); re-clone if needed.
vendor/

# ── Archives / large binaries ────────────────────────────────────────
*.tar
*.zip

.vercel
